{
  "$schema": "https://schema.tauri.app/config/capability/1",
  "identifier": "default",
  "description": "Permisos por defecto para el workspace y shell",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "shell:default",
    "fs:default"
  ]
}
